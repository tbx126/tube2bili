{
  "manifest_version": 3,
  "name": "Tube2Bili YouTube Cookie Sync",
  "version": "1.0.0",
  "description": "Sync YouTube cookies to your paired Tube2Bili NAS dashboard.",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["https://*.youtube.com/*", "http://192.168.5.6/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "Tube2Bili Cookie Sync", "default_popup": "popup.html"}
}
